# Local / Node host config. Copy to .env (or .dev.vars for wrangler). Never commit either.
# Leave TYPESAFE_API_KEY empty for mock mode: a keyword stand-in, clearly badged, no Jev call.
TYPESAFE_API_KEY=
# Any random string. Enables reviewer votes and guards the owner view of /api/stats.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FEEDBACK_SECRET=
# Optional, only for evals/compare.mjs (head-to-head against a Groq-hosted LLM).
GROQ_API_KEY=
